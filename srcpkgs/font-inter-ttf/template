# Template file for 'font-inter-ttf'
pkgname=font-inter-ttf
version=4.1
revision=4
depends="font-util"
short_desc="The Inter typeface family"
maintainer="VoizLinux <iz@anrix.org>"
license="OFL-1.1"
homepage="https://rsms.me/inter/"
distfiles="https://github.com/rsms/inter/releases/download/v${version}/Inter-${version}.zip"
checksum=9883fdd4a49d4fb66bd8177ba6625ef9a64aa45899767dde3d36aa425756b11e
font_dirs="/usr/share/fonts/TTF"

do_install() {
	vmkdir usr/share/fonts/TTF

	for font in extras/ttf/Inter-*.ttf; do
		vinstall "$font" 644 usr/share/fonts/TTF
	done
}
